generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  name String
  passwordHash String
  ownedProjects Project[] @relation("Owner")
  memberships Membership[]
  assignedIssues Issue[] @relation("Assignee")
  reportedIssues Issue[] @relation("Reporter")
  notifications Notification[]
}
model Project {
  id String @id @default(cuid())
  name String
  key String @unique
  subTitle String
  ownerId String
  owner User @relation("Owner", fields: [ownerId], references: [id])
  members Membership[]
  sprints Sprint[]
  issues Issue[]
  issueSequence Int @default(2000)
}
model Membership {
  userId String
  projectId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([userId, projectId])
}
enum IssueStatus {
  TO_DO
  IN_PROGRESS
  REVIEW
  DONE
}
enum IssueType {
  STORY
  BUG
}
enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}
model Sprint {
  id String @id @default(cuid())
  name String
  goal String
  projectId String
  startDate String
  endDate String
  status SprintStatus @default(PLANNED)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues Issue[]
  @@index([projectId, status])
}
model Issue {
  id String @id @default(cuid())
  issueNumber String @unique
  summary String
  description String @default("")
  projectId String
  sprintId String?
  assigneeUserId String?
  reporterUserId String
  status IssueStatus @default(TO_DO)
  type IssueType @default(STORY)
  storyPoints Int @default(0)
  orderIndex Int @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee User? @relation("Assignee", fields: [assigneeUserId], references: [id])
  reporter User @relation("Reporter", fields: [reporterUserId], references: [id])
  notifications Notification[]
  @@index([projectId, sprintId, orderIndex])
}
model Notification {
  id String @id @default(cuid())
  userId String
  issueId String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  @@index([userId, read])
}
